# ==============================================================================
# E-Commerce Intelligence Platform - PostgreSQL Environment Variables
# ==============================================================================
# Copy this file to .env and adjust credentials as appropriate for your environment.
# Never commit .env containing production secrets to version control.

# Database Host and Port
DB_HOST=localhost
DB_PORT=5432

# Production / Analytics Database
DB_NAME=ecommerce_intelligence
DB_USER=ecommerce_user
DB_PASSWORD=ecommerce_secure_pass_2026
DB_SCHEMA=public

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Isolated Test Database for Pytest
TEST_DB_NAME=ecommerce_intelligence_test

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
.env/

# IDE & Editor settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.ipynb_checkpoints/

# Environment Variables & Secrets
.env
.env.*
!.env.example
secrets/
*.pem
*.key
credentials.json

# Platform Datasets & Data Artifacts (Preserve raw/bronze schemas, ignore large data files)
data/raw/*
!data/raw/.gitkeep
data/bronze/*
!data/bronze/.gitkeep
data/silver/*
!data/silver/.gitkeep
data/gold/*
!data/gold/.gitkeep
*.parquet
*.xlsx
*.csv
*.zip
*.tar.gz

# Logs & Runtime metadata
logs/*
!logs/.gitkeep
*.log
*.sqlite
data/metadata/*
!data/metadata/.gitkeep

# Pytest & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Docker
.dockerignore.bak
